{
    "version": 2,
    "builds": [
        {
            "src": "core/wsgi.py",
            "use": "@vercel/python",
            "config": {
                "runtime": "python3.12",
                "maxLambdaSize": "15mb"
            }
        },
        {
            "src": "opaque-sidecar.go",
            "use": "@vercel/go"
        },
        {
            "src": "build_files.sh",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "staticfiles"
            }
        }
    ],
    "routes": [
        {
            "src": "/opaque-sidecar",
            "dest": "/opaque-sidecar"
        },
        {
            "src": "/(.*)",
            "dest": "core/wsgi.py"
        }
    ],
    "crons": [
        {
            "path": "/telemetry/internal/compute-metrics/",
            "schedule": "59 23 * * *"
        }
    ]
}